{
  "server": {
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.acme/issues",
    "description": "Issue tracker access over a hosted endpoint.",
    "version": "0.9.1",
    "remotes": [
      {
        "type": "streamable-http",
        "url": "https://mcp.acme.dev/issues",
        "headers": [
          {
            "name": "Authorization",
            "description": "Personal access token",
            "isRequired": true,
            "value": "Bearer {token}",
            "variables": { "token": { "description": "Token", "isRequired": true, "isSecret": true } }
          }
        ]
      }
    ]
  },
  "_meta": {
    "io.modelcontextprotocol.registry/official": {
      "status": "active",
      "isLatest": true,
      "publishedAt": "2026-10-03T11:00:00Z",
      "updatedAt": "2026-10-03T11:00:00Z"
    },
    "com.artifactkeeper.registry/source": {
      "repository": "e2e-mcp-local",
      "artifactId": "00000000-0000-4000-8000-00000000a003",
      "packagePolicy": "own-repos",
      "origin": "hosted",
      "upstreamVerified": false
    }
  }
}
