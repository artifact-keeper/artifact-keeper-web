# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# worktrees
.worktrees/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tutorial recordings
e2e/tutorials/output/

# Worktrees created by Claude Code agents
.claude/worktrees/
npm-ci.log

# Visual regression: baselines are committed for the CI platform (Linux) only.
# The suite renders on ubuntu-latest; baselines generated on other OSes locally
# are throwaway. Ignore them so a wrong-platform image can't re-enter the repo.
# Refresh Linux baselines via the "Update Visual Baselines" workflow.
e2e/suites/visual/**/*-darwin.png
e2e/suites/visual/**/*-win32.png
